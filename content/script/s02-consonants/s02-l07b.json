{
  "id": "s02-l07b",
  "unit": "s02-consonants",
  "title": "Consonants 7b: ৎ ং ঃ ঁ",
  "status": "draft",
  "tip": "Four special signs finish the chart.\n\n- **ৎ** is a t that never takes a vowel: হঠাৎ (`hothat`, suddenly), উৎসব (`utshob`, festival).\n- **ং** = `ng` at the end of a syllable: বাংলা (`bangla`). Same sound as ঙ.\n- **ঃ** = a little breath; inside a word it doubles the next consonant: দুঃখিত (`dukkhito`, sorry).\n- **ঁ** (moon and dot) sits *above* a letter and makes the vowel nasal: চাঁদ (`cha~d`, moon), হ্যাঁ (`hya~`). The `~` marks it.",
  "vocab": [
    {
      "id": "l-khondo-to",
      "bn": "ৎ",
      "tr": "t",
      "en": "final t with no vowel after it",
      "notes": "Name: khondo to (খণ্ড ত), 'broken t'. U+09CE. Only appears at the end of a syllable (হঠাৎ, উৎসব)."
    },
    {
      "id": "l-onushshar",
      "bn": "ং",
      "tr": "ng",
      "en": "ng as in 'sing' (nasal at the end of a syllable)",
      "notes": "Name: onushshar (অনুস্বার). U+0982. Same sound as ঙ. Shown standalone here; fonts may draw a dotted circle."
    },
    {
      "id": "l-bishorgo",
      "bn": "ঃ",
      "tr": "h",
      "en": "a short breath; inside a word it doubles the next consonant",
      "notes": "Name: bishorgo (বিসর্গ). U+0983. দুঃখিত is said dukkhito: the ঃ makes the খ double. Shown standalone; fonts may draw a dotted circle."
    },
    {
      "id": "l-chondrobindu",
      "bn": "আঁ",
      "tr": "a~",
      "en": "ঁ makes the vowel nasal (shown on আ: a~)",
      "notes": "Sign: chondrobindu (চন্দ্রবিন্দু) ঁ, U+0981, 'moon and dot', written above the letter. Shown on আ because it cannot stand alone."
    },
    {
      "id": "hothat",
      "bn": "হঠাৎ",
      "tr": "hothat",
      "en": "suddenly"
    },
    {
      "id": "dukkhito",
      "bn": "দুঃখিত",
      "tr": "dukkhito",
      "en": "sorry",
      "notes": "'I'm sorry' = আমি দুঃখিত (formal). Shows ঃ doubling the খ."
    },
    {
      "id": "chad",
      "bn": "চাঁদ",
      "tr": "cha~d",
      "en": "moon",
      "notes": "The transliteration guide's own example of ঁ."
    }
  ],
