{
  "unit": "u12-have-to",
  "entries": [
    {
      "id": "korte",
      "bn": "করতে",
      "tr": "korte",
      "en": "to do",
      "pos": "verb",
      "lesson": "u12-l01",
      "notes": "Infinitive of করা: কর- + -তে. Same spelling as তুমি করতে \"you used to do\", met later."
    },
    {
      "id": "jete",
      "bn": "যেতে",
      "tr": "jete",
      "en": "to go",
      "pos": "verb",
