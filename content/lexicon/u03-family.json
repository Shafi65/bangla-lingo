    {
      "id": "tomader",
      "bn": "তোমাদের",
      "tr": "tomader",
      "en": "your (familiar, plural)",
      "alt": [
        "your"
      ],
      "pos": "pronoun",
      "lesson": "u03-l05",
      "register": "familiar"
    },
    {
      "id": "bachcha",
      "bn": "বাচ্চা",
      "tr": "bachcha",
      "en": "child",
      "alt": [
        "kid",
        "children",
        "baby"
      ],
      "pos": "noun",
      "lesson": "u03-l05"
    },
    {
      "id": "apa",
      "bn": "আপা",
