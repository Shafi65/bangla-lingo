      "alt": [
        "aunt",
        "auntie",
        "aunty",
        "ma'am"
      ],
      "pos": "noun",
      "lesson": "u03-l06",
      "notes": "From English 'auntie'; used for friends' mothers and older women, especially in cities."
    },
    {
      "id": "shami",
      "bn": "স্বামী",
      "tr": "shami",
      "en": "husband",
      "pos": "noun",
      "lesson": "u03-l07",
      "notes": "The ব-fola after স is silent."
    },
