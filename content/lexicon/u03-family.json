      "bn": "বড়",
      "tr": "boro",
      "en": "big",
      "alt": [
        "elder",
        "older",
        "large"
      ],
      "pos": "adj",
      "lesson": "u03-l02",
      "notes": "With siblings it means 'elder': বড় ভাই 'elder brother'."
    },
    {
      "id": "chhoto",
      "bn": "ছোট",
      "tr": "chhoto",
      "en": "small",
      "alt": [
        "younger",
