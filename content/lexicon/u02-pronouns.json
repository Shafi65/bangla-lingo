    {
      "id": "nei",
      "bn": "নেই",
      "tr": "nei",
      "en": "is not (here); there isn't",
      "alt": [
        "isn't",
        "not here",
        "there is no",
        "don't have",
        "doesn't have"
      ],
      "pos": "verb",
      "lesson": "u02-l03",
      "notes": "Negative of আছ- for every person: আমি নেই, তুমি নেই, সে নেই. Colloquially also নাই (nai)."
    },
    {
      "id": "ki-q",
      "bn": "কি",
      "tr": "ki",
      "en": "(yes/no question marker)",
      "pos": "particle",
      "lesson": "u02-l04",
      "notes": "Turns a statement into a yes/no question: আপনি কি শিক্ষক? Usually comes right after the subject. Short ি — compare কী 'what'."
    },
    {
      "id": "noi",
      "bn": "নই",
      "tr": "noi",
      "en": "am not",
      "alt": [
        "not"
      ],
      "pos": "verb",
      "lesson": "u02-l04b",
      "notes": "Goes with আমি / আমরা: আমি ছাত্র নই."
    },
    {
      "id": "noo",
      "bn": "নও",
