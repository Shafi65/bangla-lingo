{
  "unit": "u02-pronouns",
  "entries": [
    {
      "id": "she",
      "bn": "সে",
      "tr": "she",
      "en": "he/she",
      "alt": [
        "he",
        "she"
      ],
      "pos": "pronoun",
      "lesson": "u02-l01",
      "notes": "Pronounced 'shay'. No gender: সে = he or she. Neutral, also the written form."
    },
    {
      "id": "o-pron",
      "bn": "ও",
      "tr": "o",
      "en": "he/she (spoken)",
      "alt": [
        "he",
        "she"
      ],
      "pos": "pronoun",
      "lesson": "u02-l01",
      "notes": "Everyday spoken 'he/she', lit. 'that one'. Used for friends, peers, children. Also a word for 'also/and' (you'll meet it later)."
    },
    {
      "id": "tini",
      "bn": "তিনি",
      "tr": "tini",
      "en": "he/she (polite)",
      "alt": [
        "he",
        "she"
      ],
      "pos": "pronoun",
      "lesson": "u02-l01",
      "register": "polite",
      "notes": "Formal/written; উনি is the spoken equivalent."
    },
    {
      "id": "uni",
      "bn": "উনি",
      "tr": "uni",
      "en": "he/she (polite, spoken)",
      "alt": [
        "he",
        "she"
      ],
      "pos": "pronoun",
      "lesson": "u02-l01",
      "register": "polite",
      "notes": "What people actually say in conversation for a respected third person."
    },
    {
      "id": "achhe",
      "bn": "আছে",
      "tr": "achhe",
      "en": "is (he/she/it)",
      "alt": [
        "is",
        "there is",
        "has"
      ],
      "pos": "verb",
      "lesson": "u02-l01",
      "notes": "Goes with সে, ও, তারা. Also means 'there is' / 'exists'."
    },
