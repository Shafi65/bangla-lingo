      "id": "e03",
      "type": "reading",
      "title": "Family in Sylhet",
      "lines": [
        {
          "speaker": "Nadia",
          "bn": "তোমার ভাই কোথায় থাকে?",
          "tr": "tomar bhai kothay thake?",
          "en": "Where does your brother live?"
        },
        {
          "speaker": "Rafi",
          "bn": "ও সিলেটে থাকে। ওর বউ ডাক্তার।",
          "tr": "o shilete thake. or bou daktar.",
          "en": "He lives in Sylhet. His wife is a doctor."
        },
        {
          "speaker": "Nadia",
          "bn": "ওদের কি বাচ্চা আছে?",
          "tr": "oder ki bachcha achhe?",
          "en": "Do they have children?"
        },
        {
          "speaker": "Rafi",
          "bn": "হ্যাঁ, একটা মেয়ে। আমি ওকে খুব ভালোবাসি।",
          "tr": "hya~, ekta meye. ami oke khub bhalobashi.",
          "en": "Yes, a girl. I love her very much."
        },
        {
          "speaker": "Nadia",
          "bn": "তুমি কীভাবে সিলেটে যাও?",
          "tr": "tumi kibhabe shilete jao?",
          "en": "How do you get to Sylhet?"
        },
        {
          "speaker": "Rafi",
          "bn": "ট্রেনে যাই, তবে অনেক সময় লাগে।",
          "tr": "trene jai, tobe onek shomoy lage.",
          "en": "By train, but it takes a long time."
        }
      ],
      "question": "Where does Rafi's brother live?",
      "options": [
        "In Dhaka",
        "Abroad",
        "In Sylhet"
      ],
      "answer": 2
    },
