    {
      "id": "e03",
      "type": "reading",
      "title": "At the tea stall",
      "lines": [
        {
          "speaker": "Rafi",
          "bn": "নাদিয়া! তুমি কেমন আছো?",
          "tr": "nadiya! tumi kemon achho?",
          "en": "Nadia! How are you?"
        },
        {
          "speaker": "Nadia",
          "bn": "ভালো আছি। তুমি এখন কী করছো?",
          "tr": "bhalo achhi. tumi ekhon ki korchho?",
          "en": "I'm well. What are you doing these days?"
        },
        {
          "speaker": "Rafi",
          "bn": "আমি একটা অফিসে কাজ করি। প্রতিদিন সকালে বাসে যাই।",
          "tr": "ami ekta ofise kaj kori. protidin shokale base jai.",
          "en": "I work in an office. I go by bus every morning."
        },
        {
          "speaker": "Rafi",
          "bn": "আর এখন আমি ইংরেজি শিখছি।",
          "tr": "ar ekhon ami ingreji shikhchhi.",
          "en": "And now I'm learning English."
        },
        {
          "speaker": "Nadia",
          "bn": "আমি এখন ঢাকায় থাকি। আমার বোন এখানে পড়ে।",
          "tr": "ami ekhon dhakay thaki. amar bon ekhane pore.",
          "en": "I live in Dhaka now. My sister studies here."
        },
        {
          "speaker": "Rafi",
          "bn": "চলো, চা খাই।",
          "tr": "cholo, cha khai.",
          "en": "Come on, let's have tea."
        }
      ],
      "question": "How does Rafi get to work?",
      "options": [
        "By train",
        "By bus",
        "On foot"
      ],
      "answer": 1
    },
