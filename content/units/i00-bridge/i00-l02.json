      "lines": [
        {
          "speaker": "Rafi",
          "bn": "তুমি কবে এলে?",
          "tr": "tumi kobe ele?",
          "en": "When did you get back?"
        },
        {
          "speaker": "Nadia",
          "bn": "আমি গত সপ্তাহে এলাম।",
          "tr": "ami goto shoptahe elam.",
          "en": "I came last week."
        },
        {
          "speaker": "Rafi",
          "bn": "এক বছর কোথায় ছিলে?",
          "tr": "ek bochhor kothay chhile?",
          "en": "Where were you for a year?"
        },
        {
          "speaker": "Nadia",
          "bn": "আমি সিলেটে ছিলাম। ওখানে আমি একটা নতুন কাজ শিখলাম।",
          "tr": "ami shilete chhilam. okhane ami ekta notun kaj shikhlam.",
          "en": "I was in Sylhet. I learned a new job there."
        },
        {
          "speaker": "Rafi",
          "bn": "আর তোমার ভাই? ও কী করল?",
          "tr": "ar tomar bhai? o ki korlo?",
          "en": "And your brother? What did he do?"
        },
        {
          "speaker": "Nadia",
          "bn": "ও ঢাকায় একটা চাকরি পেল।",
          "tr": "o dhakay ekta chakri pelo.",
          "en": "He got a job in Dhaka."
        }
      ],
      "question": "Where was Nadia for a year?",
      "options": [
        "In Dhaka",
