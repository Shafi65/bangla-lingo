      "tr": "holud",
      "en": "yellow; turmeric",
      "notes": "Also the spice turmeric; গায়ে হলুদ is the turmeric ceremony before a wedding."
    },
    {
      "id": "kalo",
      "bn": "কালো",
      "tr": "kalo",
      "en": "black",
      "notes": "Also 'dark' for skin and hair. Comments on skin colour are common but can hurt: describe hair and clothes instead."
    },
    {
      "id": "shada",
      "bn": "সাদা",
      "tr": "shada",
      "en": "white"
    },
