        {
          "speaker": "Rafi",
          "bn": "অনেক বৃষ্টি হচ্ছে! আকাশ মেঘলা, খুব বাতাস।",
          "tr": "onek brishti hochchhe! akash meghla, khub batash.",
          "en": "It's raining a lot! It's cloudy and very windy."
        },
        {
          "speaker": "Nadia",
          "bn": "ঢাকায় আজ রোদ উঠেছে, কিন্তু খুব গরম।",
          "tr": "dhakay aj rod uthechhe, kintu khub gorom.",
          "en": "In Dhaka the sun is out today, but it's very hot."
        },
        {
          "speaker": "Rafi",
          "bn": "সিলেটে ঢাকার চেয়ে বেশি বৃষ্টি হয়। বর্ষায় সবচেয়ে বেশি।",
          "tr": "shilete dhakar cheye beshi brishti hoy. borshay shobcheye beshi.",
          "en": "It rains more in Sylhet than in Dhaka. Most of all in the monsoon."
        },
        {
          "speaker": "Nadia",
          "bn": "তোমার ছাতা আছে?",
          "tr": "tomar chhata achhe?",
          "en": "Do you have an umbrella?"
        },
        {
          "speaker": "Rafi",
          "bn": "হ্যাঁ, আছে। কিন্তু ঝড় আসছে!",
          "tr": "hya~, achhe. kintu jhor ashchhe!",
          "en": "Yes, I do. But a storm is coming!"
        }
      ],
      "question": "Where is it sunny today?",
