    {
      "id": "e01",
      "type": "reading",
      "title": "Rafi's new teacher",
      "lines": [
        {
          "speaker": "Nadia",
          "bn": "তোমাদের নতুন শিক্ষক দেখতে কেমন?",
          "tr": "tomader notun shikkhok dekhte kemon?",
          "en": "What does your new teacher look like?"
        },
        {
          "speaker": "Rafi",
          "bn": "উনি বেশ লম্বা, একটু পাতলা। ওনার চুল কালো।",
          "tr": "uni besh lomba, ektu patla. onar chul kalo.",
          "en": "He's quite tall and a bit thin. His hair is black."
        },
        {
          "speaker": "Nadia",
          "bn": "উনি কি বয়স্ক?",
          "tr": "uni ki boyoshko?",
          "en": "Is he elderly?"
        },
        {
          "speaker": "Rafi",
          "bn": "না, উনি কম বয়সী। খুব ভালো মানুষ, আর খুব মজার।",
          "tr": "na, uni kom boyoshi. khub bhalo manush, ar khub mojar.",
          "en": "No, he's young. A really kind person, and very funny."
        },
        {
          "speaker": "Nadia",
          "bn": "আমাদের শিক্ষক একটু রাগী!",
          "tr": "amader shikkhok ektu ragi!",
          "en": "Our teacher is a bit short-tempered!"
        },
        {
          "speaker": "Rafi",
          "bn": "আমাদের শিক্ষক সবার চেয়ে ভালো।",
          "tr": "amader shikkhok shobar cheye bhalo.",
          "en": "Our teacher is the best of all."
        }
      ],
      "question": "What is Rafi's new teacher like?",
      "options": [
        "Elderly and short-tempered",
        "Short and shy",
        "Young, kind and funny",
        "Old but cheerful"
      ],
      "answer": 2,
      "why": "Rafi says **উনি কম বয়সী**, **খুব ভালো মানুষ** and **খুব মজার**."
    },
