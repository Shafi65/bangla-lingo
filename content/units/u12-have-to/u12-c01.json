      "title": "Plans for Eid",
      "lines": [
        {
          "speaker": "Nadia",
          "bn": "রাফি, ঈদে তুমি কী করবে?",
          "tr": "rafi, ide tumi ki korbe?",
          "en": "Rafi, what will you do at Eid?"
        },
        {
          "speaker": "Rafi",
          "bn": "আমি গ্রামে যাব, কিন্তু আগে আমাকে বাজারে যেতে হবে।",
          "tr": "ami grame jabo, kintu age amake bajare jete hobe.",
          "en": "I'll go to the village, but first I have to go to the market."
        },
        {
          "speaker": "Nadia",
          "bn": "বাজারে কী কিনবে?",
          "tr": "bajare ki kinbe?",
          "en": "What will you buy at the market?"
        },
        {
          "speaker": "Rafi",
          "bn": "মায়ের জন্য একটা নতুন শাড়ি কিনব।",
          "tr": "mayer jonno ekta notun shari kinbo.",
          "en": "I'll buy a new sari for my mother."
        },
        {
          "speaker": "Nadia",
          "bn": "ঈদের দিন আমাদের বাসায় আসবে?",
          "tr": "ider din amader bashay ashbe?",
          "en": "Will you come to our home on Eid day?"
        },
        {
          "speaker": "Rafi",
          "bn": "দুঃখিত, আমি আসতে পারব না, কারণ আমি গ্রামে থাকব।",
          "tr": "dukkhito, ami ashte parbo na, karon ami grame thakbo.",
          "en": "Sorry, I won't be able to come, because I'll be in the village."
        },
        {
          "speaker": "Nadia",
          "bn": "ঠিক আছে, ঈদ মোবারক!",
          "tr": "thik achhe, id mubarak!",
          "en": "OK, Eid Mubarak!"
        }
      ],
      "question": "Why can't Rafi come to Nadia's home on Eid day?",
      "options": [
        "He has to go to the market",
        "He will be in the village",
        "He has to work"
