      "id": "e03",
      "type": "reading",
      "title": "How did you get here?",
      "lines": [
        {
          "speaker": "Rafi",
          "bn": "নাদিয়া, তুমি কীভাবে এলে?",
          "tr": "nadiya, tumi kibhabe ele?",
          "en": "Nadia, how did you get here?"
        },
        {
          "speaker": "Nadia",
          "bn": "আজ আমি হেঁটে এলাম।",
          "tr": "aj ami he~te elam.",
          "en": "Today I came on foot."
        },
        {
          "speaker": "Rafi",
          "bn": "হেঁটে? তোমার বাসা অনেক দূরে।",
          "tr": "he~te? tomar basha onek dure.",
          "en": "On foot? Your home is a long way away."
        },
        {
          "speaker": "Nadia",
          "bn": "হ্যাঁ, আজ কোনো রিকশা ছিল না।",
          "tr": "hya~, aj kono riksha chhilo na.",
          "en": "Yes, there weren't any rickshaws today."
        },
        {
          "speaker": "Nadia",
          "bn": "বৃষ্টি হচ্ছিল, তাই আমি ভিজে গেলাম।",
          "tr": "brishti hochchhilo, tai ami bhije gelam.",
          "en": "It was raining, so I got soaked."
        },
        {
          "speaker": "Rafi",
          "bn": "কাল রিকশা করে এসো।",
          "tr": "kal riksha kore esho.",
          "en": "Come by rickshaw tomorrow."
        }
      ],
      "question": "How did Nadia get here today?",
      "options": [
        "By rickshaw",
        "On foot",
        "By bus"
      ],
      "answer": 1
    },
