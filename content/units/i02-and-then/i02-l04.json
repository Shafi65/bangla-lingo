      "id": "e03",
      "type": "reading",
      "title": "Breakfast",
      "lines": [
        {
          "speaker": "Mum",
          "bn": "রাফি, তুমি কি নাস্তা খেয়েছো?",
          "tr": "rafi, tumi ki nashta kheyechho?",
          "en": "Rafi, have you had breakfast?"
        },
        {
          "speaker": "Rafi",
          "bn": "না, আম্মু। আজ আমি না খেয়ে যাব। দেরি হচ্ছে।",
          "tr": "na, ammu. aj ami na kheye jabo. deri hochchhe.",
          "en": "No, Mum. Today I'll go without eating. I'm late."
        },
        {
          "speaker": "Mum",
          "bn": "না খেয়ে যাবে না!",
          "tr": "na kheye jabe na!",
          "en": "You're not going without eating!"
        },
        {
          "speaker": "Rafi",
          "bn": "আব্বু কোথায়?",
          "tr": "abbu kothay?",
          "en": "Where's Dad?"
        },
        {
          "speaker": "Mum",
          "bn": "উনি সকালে আমাকে না বলে অফিসে গেলেন।",
          "tr": "uni shokale amake na bole ofise gelen.",
          "en": "He went to the office this morning without telling me."
        },
        {
          "speaker": "Rafi",
          "bn": "আচ্ছা, আমি একটা রুটি নিয়ে যাচ্ছি।",
          "tr": "achchha, ami ekta ruti niye jachchhi.",
          "en": "OK, I'm taking a roti with me."
        }
      ],
      "question": "Why does Rafi want to skip breakfast?",
      "options": [
        "He ate at a friend's",
        "He isn't hungry",
        "He is late"
      ],
      "answer": 2
