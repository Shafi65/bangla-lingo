      "lines": [
        {
          "speaker": "Rafi",
          "bn": "নানি, তুমি ছোটবেলায় কী করতে?",
          "tr": "nani, tumi chhotobelay ki korte?",
          "en": "Nani, what did you use to do when you were small?"
        },
        {
          "speaker": "Nani",
          "bn": "আমি প্রতিদিন স্কুলে যেতাম।",
