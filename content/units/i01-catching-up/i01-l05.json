        {
          "speaker": "Nadia",
          "bn": "রাফি, কাল রাতে আমি ফোন করলাম, তুমি কোথায় ছিলে?",
          "tr": "rafi, kal rate ami fon korlam, tumi kothay chhile?",
          "en": "Rafi, I called last night. Where were you?"
        },
        {
          "speaker": "Rafi",
          "bn": "আমি বাসায় ছিলাম। ঘুমাচ্ছিলাম।",
          "tr": "ami bashay chhilam. ghumachchhilam.",
          "en": "I was at home. I was sleeping."
        },
        {
          "speaker": "Nadia",
          "bn": "আটটায়?",
          "tr": "attay?",
          "en": "At eight o'clock?"
        },
