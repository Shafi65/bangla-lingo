    {
      "id": "e07",
      "type": "reading",
      "title": "Buying a sari",
      "lines": [
        {
          "speaker": "Nadia",
          "bn": "ভাই, এই শাড়িটা কত?",
          "tr": "bhai, ei sharita koto?",
          "en": "Brother, how much is this sari?"
        },
        {
          "speaker": "Shopkeeper",
          "bn": "এক হাজার টাকা। এটা সবচেয়ে ভালো শাড়ি।",
          "tr": "ek hajar taka. eta shobcheye bhalo shari.",
          "en": "A thousand taka. This is the best sari."
        },
        {
          "speaker": "Nadia",
          "bn": "এত দাম কেন? একটু কম রাখেন।",
          "tr": "eto dam keno? ektu kom rakhen.",
          "en": "Why so expensive? Please lower it a little."
        },
        {
          "speaker": "Shopkeeper",
          "bn": "ঠিক আছে, শেষ দাম পাঁচশ টাকা। কিনবেন?",
          "tr": "thik achhe, shesh dam pa~chsho taka. kinben?",
          "en": "OK, the final price is five hundred taka. Will you buy it?"
        },
        {
          "speaker": "Nadia",
          "bn": "হ্যাঁ, কিনব। কিন্তু ব্যাগ লাগবে না।",
          "tr": "hya~, kinbo. kintu byag lagbe na.",
          "en": "Yes, I'll buy it. But I don't need a bag."
        }
      ],
      "question": "How much will Nadia pay for the sari?",
      "options": [
        "A thousand taka",
        "Five hundred taka",
        "Fifty taka"
      ],
      "answer": 1
    },
