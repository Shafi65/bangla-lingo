{
  "id": "u01-l02",
  "unit": "u01-basics",
  "title": "I and you",
  "tip": "Bengali has more than one 'you'. Use **আপনি** (*apni*) with elders, strangers, teachers and anyone you want to show respect to. Use **তুমি** (*tumi*) with friends, younger people and partners. (There is also a very intimate **তুই** (*tui*) for close friends and small children; it is rude with strangers, so we leave it for Unit 2.) When unsure, use আপনি.\n\nThere is no 'am / is / are' in simple present sentences and no 'a / the': **আমি ছাত্র** (*ami chhatro*) = 'I (am a) student'.",
  "vocab": [
    { "id": "ami", "bn": "আমি", "tr": "ami", "en": "I" },
    { "id": "tumi", "bn": "তুমি", "tr": "tumi", "en": "you (familiar)", "notes": "For friends, younger people, partners." },
    { "id": "apni", "bn": "আপনি", "tr": "apni", "en": "you (polite)", "notes": "Safe default with anyone older or unfamiliar." },
    { "id": "chhatro", "bn": "ছাত্র", "tr": "chhatro", "en": "student (male)", "notes": "Often used for any student regardless of gender." },
    { "id": "chhatri", "bn": "ছাত্রী", "tr": "chhatri", "en": "student (female)" },
    { "id": "shikkhok", "bn": "শিক্ষক", "tr": "shikkhok", "en": "teacher", "notes": "The conjunct ক্ষ is pronounced 'kkh'. A female teacher is শিক্ষিকা (shikkhika), though শিক্ষক is increasingly used for all." }
  ],
