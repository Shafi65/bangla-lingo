    {
      "id": "e01",
      "type": "reading",
      "title": "Friday plans",
      "lines": [
        {
          "speaker": "Rafi",
          "bn": "নাদিয়া, শুক্রবার তোমার প্ল্যান কী? বাসায় থাকবে?",
          "tr": "nadiya, shukrobar tomar plyan ki? bashay thakbe?",
          "en": "Nadia, what's your plan for Friday? Will you stay at home?"
        },
        {
          "speaker": "Nadia",
          "bn": "সকালে বাসায় বই পড়ব। বিকালে আমরা মেলায় বেড়াতে যাব।",
          "tr": "shokale bashay boi porbo. bikale amra melay berate jabo.",
          "en": "In the morning I'll read at home. In the afternoon we'll go out to the fair."
        },
        {
          "speaker": "Rafi",
          "bn": "মেলায় কী করবে?",
          "tr": "melay ki korbe?",
          "en": "What will you do at the fair?"
        },
        {
          "speaker": "Nadia",
          "bn": "আম্মু শাড়ি কিনবে, আর আমি পিঠা খাব। তুমি কি আমাদের সাথে যাবে?",
          "tr": "ammu shari kinbe, ar ami pitha khabo. tumi ki amader shathe jabe?",
          "en": "Mum will buy a sari, and I'll eat pitha. Will you come with us?"
        },
        {
          "speaker": "Rafi",
          "bn": "ইনশাআল্লাহ যাব। কয়টায় আসব?",
          "tr": "inshaallah jabo. koytay ashbo?",
          "en": "God willing, I'll go. What time shall I come?"
        },
        {
          "speaker": "Nadia",
          "bn": "দুপুরে আমাদের বাসায় খাবে, তারপর যাব। শুক্রবার দেখা হবে।",
          "tr": "dupure amader bashay khabe, tarpor jabo. shukrobar dekha hobe.",
          "en": "Have lunch at our place, then we'll go. See you on Friday."
        }
      ],
