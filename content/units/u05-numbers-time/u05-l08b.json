      "tr": "shoptahe",
      "en": "in a week",
      "notes": "সপ্তাহ (shoptaho) 'week' + -এ."
    },
    {
      "id": "bochhor",
      "bn": "বছর",
      "tr": "bochhor",
      "en": "year",
      "notes": "আমার বয়স বিশ বছর = 'I am twenty years old'."
    },
    {
      "id": "bochhore",
      "bn": "বছরে",
      "tr": "bochhore",
      "en": "in a year"
    },
    {
