    {
      "id": "e01",
      "type": "reading",
      "title": "A call for Nadia",
      "lines": [
        {
          "speaker": "Rafi",
          "bn": "হ্যালো, আন্টি, আমি রাফি বলছি।",
          "tr": "hyalo, anti, ami rafi bolchhi.",
          "en": "Hello, auntie, this is Rafi."
        },
        {
          "speaker": "Auntie",
          "bn": "হ্যাঁ, রাফি, বলো।",
          "tr": "hya~, rafi, bolo.",
          "en": "Yes, Rafi, go ahead."
        },
        {
          "speaker": "Rafi",
          "bn": "নাদিয়া কি আছে?",
          "tr": "nadiya ki achhe?",
          "en": "Is Nadia there?"
        },
        {
          "speaker": "Auntie",
          "bn": "ও এখন বাসায় নেই। পরে ফোন করো।",
          "tr": "o ekhon bashay nei. pore fon koro.",
          "en": "She isn't home now. Call later."
        },
        {
          "speaker": "Rafi",
          "bn": "আমি ওকে ফোন করেছি, কিন্তু ও ফোন ধরছে না।",
          "tr": "ami oke fon korechhi, kintu o fon dhorchhe na.",
          "en": "I called her, but she isn't picking up."
        },
        {
          "speaker": "Auntie",
          "bn": "ওর ফোনে চার্জ নেই। আমি ওকে বলব।",
          "tr": "or fone charj nei. ami oke bolbo.",
          "en": "Her phone has no charge. I'll tell her."
        },
        {
          "speaker": "Rafi",
          "bn": "অনেক ধন্যবাদ, আন্টি। আচ্ছা, এখন রাখি।",
          "tr": "onek dhonnobad, anti. achchha, ekhon rakhi.",
          "en": "Thanks a lot, auntie. OK, I'll hang up now."
        }
      ],
      "question": "Why isn't Nadia answering her phone?",
      "options": [
        "Her phone has no charge.",
        "She is asleep.",
        "The line is busy."
      ],
      "answer": 0,
      "why": "**ওর ফোনে চার্জ নেই** 'her phone has no charge'."
    },
    {
      "id": "e02",
      "type": "reading",
      "title": "Texts",
      "lines": [
        {
          "speaker": "Nadia",
          "bn": "রাফি, তোমার মেসেজ পেয়েছি।",
          "tr": "rafi, tomar mesej peyechhi.",
          "en": "Rafi, I got your message."
        },
        {
          "speaker": "Nadia",
          "bn": "আমি এখন বাসায় পৌঁছেছি।",
          "tr": "ami ekhon bashay pou~chhechhi.",
          "en": "I've reached home now."
        },
        {
          "speaker": "Rafi",
          "bn": "কাল কয়টায় আসবে? আমাকে জানাও।",
          "tr": "kal koytay ashbe? amake janao.",
          "en": "What time will you come tomorrow? Let me know."
        },
        {
          "speaker": "Nadia",
          "bn": "দশটায় আসব। তোমার ঠিকানা পাঠাও।",
          "tr": "doshtay ashbo. tomar thikana pathao.",
          "en": "I'll come at ten. Send your address."
        },
        {
          "speaker": "Rafi",
          "bn": "ঠিক আছে, এখনই পাঠাব।",
          "tr": "thik achhe, ekhoni pathabo.",
          "en": "OK, I'll send it right now."
        }
      ],
      "question": "What time will Nadia come tomorrow?",
      "options": [
        "At ten",
        "At five",
        "At eight"
