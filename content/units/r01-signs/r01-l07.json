{
  "id": "r01-l07",
  "unit": "r01-signs",
  "title": "Counters and services",
  "status": "draft",
  "tip": "Counters and services have formal names. Each has an everyday partner you already say:\n\n- **প্রয়োজন** = দরকার 'need'\n- **কার্যালয়** = অফিস 'office'\n- **শৌচাগার** = বাথরুম, টয়লেট 'toilet'\n- **সারিতে** = লাইনে 'in the queue'\n\n**গ্রাহক সেবা** is 'customer service' and **সংরক্ষিত আসন** is a 'reserved seat'.\n\n**Conjuncts:** **গ্র** is গ + র-ফলা (**গ্রাহক** *grahok*). **র্য** is a ref on য (**কার্যালয়** *karjaloy*). In **শৌচাগার** the ৌ sign wraps the শ: *shou*.",
  "vocab": [
    {
      "id": "sheba",
      "bn": "সেবা",
      "tr": "sheba",
      "en": "service",
      "notes": "Register: formal; also heard in speech. গ্রাহক সেবা 'customer service'."
    },
    {
      "id": "grahok",
      "bn": "গ্রাহক",
      "tr": "grahok",
      "en": "customer",
      "notes": "Register: formal (written). গ্র = গ + র (ro-fola)."
    },
    {
      "id": "sharite",
      "bn": "সারিতে",
      "tr": "sharite",
      "en": "in the queue; in line",
      "notes": "Register: formal (written). Everyday word: লাইনে. From সারি 'row, queue' (everyday লাইন)."
    },
    {
      "id": "shakha",
      "bn": "শাখা",
      "tr": "shakha",
      "en": "branch",
      "notes": "Register: formal (written). প্রধান শাখা 'main branch'."
    },
    {
      "id": "karjaloy",
      "bn": "কার্যালয়",
      "tr": "karjaloy",
      "en": "office (formal)",
      "notes": "Register: formal (written). Everyday word: অফিস. র্য = ref on য: kar-ja-loy."
    },
    {
      "id": "shouchagar",
      "bn": "শৌচাগার",
      "tr": "shouchagar",
      "en": "toilet (formal)",
      "notes": "Register: formal (written). Everyday word: বাথরুম. Sign word; in speech বাথরুম or টয়লেট. শ + ৌ."
    },
    {
      "id": "purush",
      "bn": "পুরুষ",
      "tr": "purush",
      "en": "men; male",
      "notes": "Register: formal; also heard in speech. পুরুষ শৌচাগার 'men's toilet'. Ends in ষ."
    },
    {
      "id": "ashon",
      "bn": "আসন",
      "tr": "ashon",
      "en": "seat",
      "notes": "Register: formal (written). সংরক্ষিত আসন 'reserved seat' (everyday সিট)."
    },
    {
      "id": "proyojon",
      "bn": "প্রয়োজন",
      "tr": "proyojon",
      "en": "need (formal)",
      "notes": "Register: formal (written). Everyday word: দরকার. Written partner of দরকার. প্র + য়."
    }
  ],
