      "id": "onar",
      "bn": "ওনার",
      "tr": "onar",
      "en": "his/her (polite)",
      "notes": "Possessive of উনি. Written: তাঁর (ta~r)."
    },
    {
      "id": "tor",
      "bn": "তোর",
      "tr": "tor",
      "en": "your (intimate)",
      "notes": "Possessive of তুই."
    }
  ],
