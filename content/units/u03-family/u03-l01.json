      "en": "mother"
    },
    {
      "id": "baba",
      "bn": "বাবা",
      "tr": "baba",
      "en": "father",
      "notes": "Also used affectionately by parents to address their own children."
    },
    {
      "id": "ammu",
      "bn": "আম্মু",
      "tr": "ammu",
      "en": "mom",
      "notes": "Affectionate, very common in Bangladeshi Muslim families. Also আম্মা (amma). Kolkata: মা."
    },
    {
      "id": "abbu",
      "bn": "আব্বু",
      "tr": "abbu",
      "en": "dad",
      "notes": "Affectionate, very common in Bangladeshi Muslim families. Also আব্বা (abba). Kolkata: বাবা."
    },
    {
      "id": "bhai",
      "bn": "ভাই",
      "tr": "bhai",
      "en": "brother",
      "notes": "Also a friendly address for any man about your age: ভাই, … 'Brother, …'."
    },
    {
      "id": "bon",
      "bn": "বোন",
      "tr": "bon",
      "en": "sister"
    }
  ],
