      "tr": "diye",
      "en": "along",
      "notes": "এই রাস্তা দিয়ে 'along this road'."
    },
    {
      "id": "mor",
      "bn": "মোড়",
      "tr": "mor",
      "en": "intersection",
      "notes": "Many Dhaka landmarks are named after a মোড়, e.g. শাহবাগ মোড়."
    },
    {
      "id": "more",
      "bn": "মোড়ে",
      "tr": "more",
      "en": "at the intersection"
    }
  ],
