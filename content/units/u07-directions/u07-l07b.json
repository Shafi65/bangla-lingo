    {
      "id": "e07",
      "type": "reading",
      "title": "A rickshaw ride",
      "lines": [
        {
          "speaker": "Rafi",
          "bn": "মামা, ধানমন্ডি যাবেন?",
          "tr": "mama, dhanmondi jaben?",
          "en": "Mama, will you go to Dhanmondi?"
        },
        {
          "speaker": "Driver",
          "bn": "যাব। ভাড়া একশ টাকা।",
          "tr": "jabo. bhara eksho taka.",
          "en": "I'll go. The fare is a hundred taka."
        },
        {
          "speaker": "Rafi",
          "bn": "এত ভাড়া কেন? পঞ্চাশ টাকা রাখেন।",
          "tr": "eto bhara keno? ponchash taka rakhen.",
          "en": "Why such a high fare? Make it fifty taka."
        },
        {
          "speaker": "Driver",
          "bn": "ঠিক আছে, সত্তর টাকা।",
          "tr": "thik achhe, shottor taka.",
          "en": "OK, seventy taka."
        },
        {
          "speaker": "Rafi",
          "bn": "ঠিক আছে। মোড়ে ডানে যান।",
          "tr": "thik achhe. more dane jan.",
          "en": "OK. Turn right at the intersection."
        }
      ],
      "question": "What fare do Rafi and the driver agree on?",
      "options": [
        "A hundred taka",
        "Fifty taka",
        "Seventy taka"
      ],
      "answer": 2
    },
