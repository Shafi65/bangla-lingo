  "title": {
    "bn": "নাদিয়া কে?",
    "tr": "nadiya ke?",
    "en": "Who is Nadia?"
  },
  "summary": "Rafi meets Emma, a student from America, and introduces Nadia.",
  "status": "draft",
  "lines": [
    {
      "speaker": "Rafi",
      "bn": "আসসালামু আলাইকুম। আমি রাফি।",
      "tr": "assalamu alaikum. ami rafi.",
      "en": "Hello. I'm Rafi."
    },
    {
      "speaker": "Emma",
      "bn": "ওয়ালাইকুম আসসালাম। আমি আমেরিকা থেকে এসেছি।",
      "tr": "walaikum assalam. ami amerika theke eshechhi.",
      "en": "Hello. I've come from America."
    },
    {
      "speaker": "Rafi",
      "bn": "আপনি কি ছাত্রী?",
      "tr": "apni ki chhatri?",
      "en": "Are you a student?"
    },
    {
      "speaker": "Emma",
      "bn": "হ্যাঁ, আমি ছাত্রী। আর আপনি?",
      "tr": "hya~, ami chhatri. ar apni?",
      "en": "Yes, I'm a student. And you?"
    },
    {
      "speaker": "Rafi",
      "bn": "আমি ছাত্র। ও নাদিয়া। ও ডাক্তার।",
      "tr": "ami chhatro. o nadiya. o daktar.",
      "en": "I'm a student. This is Nadia. She's a doctor."
    },
    {
      "speaker": "Nadia",
      "bn": "আপনি কেমন আছেন?",
      "tr": "apni kemon achhen?",
      "en": "How are you?"
    },
    {
      "speaker": "Emma",
      "bn": "ভালো আছি, ধন্যবাদ। রাফি কি আপনার বন্ধু?",
      "tr": "bhalo achhi, dhonnobad. rafi ki apnar bondhu?",
      "en": "I'm well, thank you. Is Rafi your friend?"
    },
    {
      "speaker": "Nadia",
      "bn": "না! ও আমার বন্ধু নয়।",
      "tr": "na! o amar bondhu noy.",
      "en": "No! He isn't my friend.",
      "senses": {
        "নয়": "noy-isnt"
      }
    },
    {
      "speaker": "Rafi",
      "bn": "আমরা বন্ধু নই?",
      "tr": "amra bondhu noi?",
      "en": "We aren't friends?"
    },
    {
      "speaker": "Nadia",
      "bn": "হ্যাঁ, হ্যাঁ। আমরা বন্ধু।",
      "tr": "hya~, hya~. amra bondhu.",
      "en": "Yes, yes. We're friends."
    }
  ],
