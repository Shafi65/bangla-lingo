          "en": "pitha"
        },
        {
          "bn": "টিকিট",
          "tr": "tikit",
          "en": "a ticket"
        }
      ],
      "answer": 0,
      "why": "ঠিকানা মেসেজ পাঠাও = send the address by message."
    }
  ]
