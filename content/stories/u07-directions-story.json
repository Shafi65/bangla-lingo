  "title": {
    "bn": "মামা ঢাকায়",
    "tr": "mama dhakay",
    "en": "Mama in Dhaka"
  },
  "summary": "Mama arrives from Sylhet and takes a rickshaw to the family's home.",
  "status": "draft",
  "lines": [
    {
      "bn": "মামা সিলেটে থাকেন।",
      "tr": "mama shilete thaken.",
      "en": "Mama, Ammu's brother, lives in Sylhet."
    },
    {
      "bn": "আজ উনি ট্রেনে ঢাকায় এসেছেন।",
      "tr": "aj uni trene dhakay eshechhen.",
      "en": "Today he has come to Dhaka by train."
    },
    {
      "speaker": "Mama",
      "bn": "ভাই, ধানমন্ডি যাবেন?",
      "tr": "bhai, dhanmondi jaben?",
      "en": "Brother, will you go to Dhanmondi?"
    },
    {
      "speaker": "Rickshaw puller",
      "bn": "যাব।",
      "tr": "jabo.",
      "en": "Yes, I'll go."
    },
    {
      "speaker": "Mama",
      "bn": "ভাড়া কত?",
      "tr": "bhara koto?",
      "en": "How much is the fare?"
    },
    {
      "speaker": "Rickshaw puller",
      "bn": "দুইশ টাকা।",
      "tr": "duisho taka.",
      "en": "Two hundred taka."
    },
    {
      "speaker": "Mama",
      "bn": "দুইশ! ধানমন্ডি কি অনেক দূরে?",
      "tr": "duisho! dhanmondi ki onek dure?",
      "en": "Two hundred! Is Dhanmondi very far?"
    },
    {
      "speaker": "Rickshaw puller",
      "bn": "না, কাছে। কিন্তু এখন অনেক গাড়ি।",
      "tr": "na, kachhe. kintu ekhon onek gari.",
      "en": "No, it's near. But there are lots of cars now."
    },
    {
      "speaker": "Mama",
      "bn": "সোজা যান। মোড়ে ডানে।",
      "tr": "shoja jan. more dane.",
      "en": "Go straight. Turn right at the intersection."
    },
    {
      "speaker": "Mama",
      "bn": "মসজিদের পাশে থামেন।",
      "tr": "moshjider pashe thamen.",
      "en": "Stop next to the mosque."
    },
    {
      "speaker": "Rafi",
      "bn": "মামা! আসসালামু আলাইকুম!",
      "tr": "mama! assalamu alaikum!",
      "en": "Mama! Hello!"
    }
  ],
