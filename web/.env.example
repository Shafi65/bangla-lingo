# Copy to web/.env.local (git-ignored) for local development, or set these in your hosting
# provider's environment variables (Vercel: Project Settings -> Environment Variables).
# Every variable is optional. Never commit real values. See docs/DEPLOY.md and docs/TRANSLATE.md.

# Azure AI Translator resource key ("Key 1" under Keys and Endpoint). Server-only: never prefix
# with NEXT_PUBLIC_. Leave empty to turn off machine translation; course lookups on /translate still work.
AZURE_TRANSLATOR_KEY=
# The resource's region / location, e.g. southeastasia, eastus, westeurope (or "global"). Server-only.
AZURE_TRANSLATOR_REGION=

# Search engines are blocked by default (robots.txt, noindex meta tag and header). Set to 1 to allow
# indexing. Read at build time, so redeploy after changing it. The reviewer pages stay blocked.
NEXT_PUBLIC_ALLOW_INDEXING=
# Only the public word pages (/bengali/...): set to 1 to let search engines index them.
NEXT_PUBLIC_INDEX_WORD_PAGES=
# Public origin for canonical links and share cards (default: the Vercel production domain).
NEXT_PUBLIC_SITE_URL=

# Optional accounts and cross-device sync (Supabase). Both must be set to turn accounts on; with
# either one empty the app has no account UI and makes no network calls for accounts. Public by
# design: the anon (publishable) key only allows what the Row Level Security policies in
# supabase/migrations allow. Read at build time, so redeploy after changing. See docs/ACCOUNTS.md.
# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The project's anon / publishable key (never the service-role or secret key).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Extra sign-in buttons besides the email link, comma-separated. Supported: google. Turn the
# provider on in Supabase first (docs/ACCOUNTS.md, "Google sign-in later").
NEXT_PUBLIC_AUTH_PROVIDERS=
