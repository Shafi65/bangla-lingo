# Copy to web/.env.local (git-ignored) for local development, or set these in your hosting
# provider's environment variables for the live site. Server-only: never prefix with NEXT_PUBLIC_.
# See docs/TRANSLATE.md.

# Azure AI Translator resource key ("Key 1" under Keys and Endpoint). Leave empty to turn off
# machine translation; course lookups on /translate still work.
AZURE_TRANSLATOR_KEY=
# The resource's region / location, e.g. southeastasia, eastus, westeurope (or "global").
AZURE_TRANSLATOR_REGION=
